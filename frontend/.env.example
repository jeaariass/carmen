# ============================================================
# Geovisor Carmen de Apicalá — Variables de entorno frontend
# Copiar como .env y ajustar
# Nota: las variables VITE_* quedan embebidas en el bundle.
# API_KEY expuesta es aceptable — solo identifica el proyecto.
# ============================================================

# URL base del backend de ESTE geovisor (según Nginx)
VITE_API_URL=/api/gv/carmen

# URL de la intranet CTGlobal (para login directo)
VITE_INTRANET_URL=https://ctglobal.com.co/api/intranet

# API key del proyecto (identifica el geovisor en el login)
VITE_PROJECT_API_KEY=ctg_live_gv002_carmen_apicala

# Nombre visible del proyecto
VITE_PROJECT_NAME=Carmen de Apicalá — EOT

# Base path de Vite (debe coincidir con la ruta en Nginx)
VITE_BASE=/CARMEN_DE_APICALA/
