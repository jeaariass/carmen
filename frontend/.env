# frontend/.env  — desarrollo local
# ⚠ No subir este archivo a git (está en .gitignore)

# URL del backend de este geovisor
VITE_API_URL=/api/gv/carmen

# URL de la intranet CTGlobal
# En dev local: apunta a localhost:3001 (si tienes la intranet corriendo)
# En producción: https://ctglobal.com.co/api/intranet
VITE_INTRANET_URL=http://localhost:3001

# API key del proyecto (identifica el geovisor en el login)
VITE_PROJECT_API_KEY=ctg_live_gv002_carmen_apicala

# Nombre visible del proyecto
VITE_PROJECT_NAME=Carmen de Apicalá — EOT

# Base path (debe coincidir con vite.config.js y Nginx)
VITE_BASE=/CARMEN_DE_APICALA/
